#!/bin/bash
#PBS -N vasp651-ncl
#PBS -l nodes=1:ppn=4
#PBS -j n
#PBS -q workq

set -u
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}" || exit 1
NP=$(wc -l < "${PBS_NODEFILE:?PBS_NODEFILE is not set}") || exit 1
EXEC=/path/to/vasp_ncl
MPIEXEC=/path/to/mpiexec
VASP_ENV_FILE=${VASP_ENV_FILE:-}
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
OUT="${PBS_JOBNAME}_${PBS_JOBID}.out"

for INPUT in INCAR POSCAR POTCAR; do
    test -r "$INPUT" || { echo "Missing input: $INPUT" >&2; exit 2; }
done

echo "VASP execution start at $(date)" > "$OUT"
(
    if [ -n "$VASP_ENV_FILE" ]; then source "$VASP_ENV_FILE" || exit 1; fi
    test -x "$EXEC" && test -x "$MPIEXEC" || exit 2
    "$MPIEXEC" -n "$NP" -machinefile "$PBS_NODEFILE" "$EXEC"
) >> "$OUT" 2>&1
rc=$?
echo "VASP execution end at $(date), exit code=$rc" >> "$OUT"
exit "$rc"
