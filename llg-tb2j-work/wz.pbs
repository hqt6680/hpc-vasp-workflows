#!/bin/bash
#PBS -N SPIN_RIBBON
#PBS -l nodes=node10:ppn=28
#PBS -j oe
#PBS -q workq

# 一个节点、一个 OpenMP 进程。由 submit.sh 提交时工作目录自动设为脚本所在目录。
# 直接 qsub wz.pbs 时，请在本文件所在目录提交。
set -euo pipefail
if [[ -n ${RIBBON_HOME:-} ]]; then
    JOB_DIRECTORY="$RIBBON_HOME"
elif [[ -n ${PBS_O_WORKDIR:-} ]]; then
    JOB_DIRECTORY="$PBS_O_WORKDIR"
else
    JOB_DIRECTORY=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
fi
cd -- "$JOB_DIRECTORY"
if [[ ! -f run.sh || ! -d program ]]; then
    printf '[PBS] Program folder not found. Submit from the folder containing wz.pbs, or use submit.sh.\n' >&2
    exit 1
fi
# run.sh 负责配置、编译检查、ppn、绘图环境；日志按配置名前缀与作业 ID 保存到本目录。
exec bash ./run.sh
